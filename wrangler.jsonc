{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ix-journal",
  "main": "src/index.tsx",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "journal.innerexcellence.com", "custom_domain": true }],
  "compatibility_date": "2026-11-20",
  // Static files (/static/*) are served straight from here; everything else hits the Worker.
  "assets": { "directory": "./public" },
  "d1_databases": [
    { "binding": "DB", "database_name": "ix-journal", "database_id": "82bd8f1d-706f-482d-8176-4f3084500ff3", "migrations_dir": "migrations" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "SENDER_EMAIL": "journal@titusmurphy.com",
    // Replies to automated emails go here.
    "REPLY_TO": "titus@innerexcellence.com",
    // Comma-separated. Get new-entry notifications and can always sign in as admin.
    "ADMIN_EMAILS": "titus@innerexcellence.com",
    "ERROR_EMAIL": "jvctext@gmail.com",
    // "false" locally (see .dev.vars): admin notifications are logged instead of emailed.
    "PRODUCTION": "true"
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
